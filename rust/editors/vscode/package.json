{
  "name": "claw-code",
  "displayName": "Claw Code",
  "description": "Agent de code et d'architecture avec n'importe quel modèle (OpenRouter, Ollama, Groq…) dans VS Code.",
  "version": "0.3.0",
  "publisher": "claw-code",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "test:client": "node test/client.test.js",
    "test:vscode": "node test/run-vscode.js",
    "package": "npx @vscode/vsce package"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "claw.open",
        "title": "Ouvrir l'agent",
        "category": "Claw",
        "icon": "$(hubot)"
      },
      {
        "command": "claw.ask",
        "title": "Poser une question",
        "category": "Claw"
      },
      {
        "command": "claw.sendSelection",
        "title": "Envoyer la sélection",
        "category": "Claw"
      },
      {
        "command": "claw.askAboutFile",
        "title": "Demander à propos de ce fichier",
        "category": "Claw"
      },
      {
        "command": "claw.acceptEdit",
        "title": "Accepter la modification proposée",
        "category": "Claw",
        "icon": "$(check)"
      },
      {
        "command": "claw.rejectEdit",
        "title": "Refuser la modification proposée",
        "category": "Claw",
        "icon": "$(close)"
      },
      {
        "command": "claw.acceptEditAlways",
        "title": "Toujours autoriser ce type de modification",
        "category": "Claw"
      },
      {
        "command": "claw.showChanges",
        "title": "Voir les modifications du dernier tour",
        "category": "Claw",
        "icon": "$(diff)"
      },
      {
        "command": "claw.showSessionChanges",
        "title": "Voir les modifications de la session",
        "category": "Claw"
      },
      {
        "command": "claw.interrupt",
        "title": "Interrompre le tour en cours",
        "category": "Claw"
      },
      {
        "command": "claw.openInBrowser",
        "title": "Ouvrir dans le navigateur",
        "category": "Claw"
      },
      {
        "command": "claw.reload",
        "title": "Recharger le panneau",
        "category": "Claw"
      },
      {
        "command": "claw.stop",
        "title": "Arrêter l'agent",
        "category": "Claw"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "claw.sendSelection",
          "when": "editorHasSelection",
          "group": "claw@1"
        },
        {
          "command": "claw.askAboutFile",
          "group": "claw@2"
        }
      ],
      "explorer/context": [
        {
          "command": "claw.askAboutFile",
          "when": "!explorerResourceIsFolder",
          "group": "claw@1"
        }
      ],
      "editor/title": [
        {
          "command": "claw.acceptEdit",
          "when": "claw.editPending && resourceScheme == claw-proposed",
          "group": "navigation@1"
        },
        {
          "command": "claw.rejectEdit",
          "when": "claw.editPending && resourceScheme == claw-proposed",
          "group": "navigation@2"
        },
        {
          "command": "claw.acceptEditAlways",
          "when": "claw.editPending && resourceScheme == claw-proposed",
          "group": "1_claw@1"
        },
        {
          "command": "claw.open",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "claw.acceptEdit",
          "when": "claw.editPending"
        },
        {
          "command": "claw.rejectEdit",
          "when": "claw.editPending"
        },
        {
          "command": "claw.acceptEditAlways",
          "when": "claw.editPending"
        }
      ]
    },
    "keybindings": [
      {
        "command": "claw.open",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      },
      {
        "command": "claw.sendSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorHasSelection"
      },
      {
        "command": "claw.acceptEdit",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "claw.editPending && resourceScheme == claw-proposed"
      },
      {
        "command": "claw.rejectEdit",
        "key": "ctrl+shift+backspace",
        "mac": "cmd+shift+backspace",
        "when": "claw.editPending && resourceScheme == claw-proposed"
      }
    ],
    "configuration": {
      "title": "Claw Code",
      "properties": {
        "claw.path": {
          "type": "string",
          "default": "claw",
          "description": "Chemin de l'exécutable claw (par défaut : celui du PATH)."
        },
        "claw.model": {
          "type": "string",
          "default": "",
          "description": "Modèle à utiliser (ex. qwen/qwen3-coder:free, ollama:qwen2.5-coder:7b). Vide : réglage de Claw."
        },
        "claw.permissionMode": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "prompt",
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "description": "Mode de permission de l'agent. Vide : réglage de Claw (prompt par défaut)."
        },
        "claw.nativeDiff": {
          "type": "boolean",
          "default": true,
          "description": "Ouvrir chaque modification proposée par l'agent dans un diff de l'éditeur, avec Accepter et Refuser (en plus de la demande affichée dans le panneau)."
        },
        "claw.editorDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Laisser l'agent lire les problèmes signalés par l'éditeur (erreurs de compilation, de types, de lint) : outil EditorDiagnostics et contrôle des fichiers modifiés à la fin d'un tour."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0"
  }
}
